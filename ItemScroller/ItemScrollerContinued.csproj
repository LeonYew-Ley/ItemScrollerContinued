<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>ItemScrollerContinued</AssemblyName>
    <RootNamespace>ItemScrollerContinued</RootNamespace>
    <Version>1.0.0</Version>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DebugType>embedded</DebugType>
    <PathMap>$(MSBuildProjectDirectory)=./,$(NuGetPackageRoot)=/_/nuget/</PathMap>
    <RestoreAdditionalProjectSources>https://api.nuget.org/v3/index.json;https://nuget.bepinex.dev/v3/index.json</RestoreAdditionalProjectSources>
    <NoWarn>$(NoWarn);CS0436</NoWarn>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GameManagedPath Condition="'$(GameManagedPath)' == '' and '$(PEAK_GAME_PATH)' != ''">$(PEAK_GAME_PATH)/PEAK_Data/Managed</GameManagedPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.0.8" PrivateAssets="all" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.1" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.4.21" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp" HintPath="$(GameManagedPath)/Assembly-CSharp.dll" Publicize="true" Private="false" />
    <Reference Include="PhotonUnityNetworking" HintPath="$(GameManagedPath)/PhotonUnityNetworking.dll" Private="false" />
    <Reference Include="Zorro.ControllerSupport" HintPath="$(GameManagedPath)/Zorro.ControllerSupport.dll" Private="false" />
    <Reference Include="Zorro.Core.Runtime" HintPath="$(GameManagedPath)/Zorro.Core.Runtime.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(GameManagedPath)/UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameManagedPath)/UnityEngine.CoreModule.dll" Private="false" />
  </ItemGroup>
  <Target Name="CheckGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GameManagedPath)/Assembly-CSharp.dll')"
           Text="Set GameManagedPath to PEAK_Data/Managed, or set PEAK_GAME_PATH to your PEAK installation directory." />
  </Target>
</Project>
